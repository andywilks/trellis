<mxfile host="app.diagrams.net">
  <diagram name="External Failover - CloudFront + Lambda@Edge" id="failover-cloudfront">
    <mxGraphModel dx="900" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="domain" value="yourdomain.example.com" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="10" y="205" width="170" height="20" as="geometry" />
        </mxCell>

        <mxCell id="f5" value="F5 Distributed&#10;Cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673A6;fontColor=#ffffff;strokeColor=none;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="195" y="180" width="80" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e_domain_f5" style="edgeStyle=none;html=1;endArrow=block;" edge="1" parent="1" source="domain" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="cf" value="CloudFront" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673A6;fontColor=#ffffff;strokeColor=none;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="360" y="180" width="80" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e_f5_cf" style="edgeStyle=none;html=1;endArrow=block;" edge="1" parent="1" source="f5" target="cf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge" value="Lambda@Edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e07b1f;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="345" y="300" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_cf_edge" style="edgeStyle=none;html=1;dashed=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cf" target="edge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="acct" value="AWS Account (Standard)" style="rounded=1;dashed=1;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="20" width="520" height="410" as="geometry" />
        </mxCell>

        <mxCell id="primary" value="Primary Region" style="rounded=1;dashed=1;strokeColor=#1f78b4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1f78b4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="460" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p_gw" value="Regional&#10;API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d94f8c;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="660" y="115" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p_lambda" value="Lambda Fn &amp;&#10;Authorizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e07b1f;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="870" y="115" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_p_gw_lambda" style="edgeStyle=none;html=1;endArrow=block;" edge="1" parent="1" source="p_gw" target="p_lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="secondary" value="Secondary Region" style="rounded=1;dashed=1;strokeColor=#1f78b4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1f78b4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="250" width="460" height="150" as="geometry" />
        </mxCell>

        <mxCell id="s_gw" value="Regional&#10;API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d94f8c;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="660" y="295" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s_lambda" value="Lambda Fn &amp;&#10;Authorizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e07b1f;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="870" y="295" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_s_gw_lambda" style="edgeStyle=none;html=1;endArrow=block;" edge="1" parent="1" source="s_gw" target="s_lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_cf_primary" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="cf" target="p_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_cf_secondary" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="cf" target="s_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="Option B — CloudFront fronts both regions; an attached Lambda@Edge function redirects to the secondary region on configured error responses." style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="430" width="700" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
